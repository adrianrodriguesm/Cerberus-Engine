#version 460

#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "Common.glsl"
#include "Camera.glsl"
#include "PathTracer.glsl"
#include "DirectionalLights.glsl"
#include "Payload.glsl"
#include "BSDF.glsl"

layout(location = 0) rayPayloadEXT HitPayload Payload;

vec3 ACESToneMap(vec3 color)
{
    mat3 inputTransform = mat3(
        0.59719, 0.07600, 0.02840,
        0.35458, 0.90834, 0.13383,
        0.04823, 0.01566, 0.83777);

    mat3 outputTransform = mat3(
        1.60475, -0.10208, -0.00327,
       -0.53108,  1.10813, -0.07276,
       -0.07367, -0.00605,  1.07602);

    vec3 transformed = inputTransform * max(color, vec3(0.0));
    vec3 numerator = transformed * (transformed + 0.0245786) - 0.000090537;
    vec3 denominator = transformed * (0.983729 * transformed + 0.4329510) + 0.238081;
    return clamp(outputTransform * (numerator / denominator), 0.0, 1.0);
}

vec3 LinearToDisplay(vec3 linearRadiance)
{
    float exposure = max(PathTracer.Presentation.x, 0.0);
    vec3 toneMapped = ACESToneMap(linearRadiance * exposure);

    // Cerberus currently presents through an UNORM swapchain, matching the
    // explicit gamma conversion used by SceneComposite.glsl.
    return pow(toneMapped, vec3(1.0 / 2.2));
}

void main()
{
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    ivec2 size = ivec2(gl_LaunchSizeEXT.xy);

    uint pixelIndex = uint(pixel.y * size.x + pixel.x);
    uint sampleIndex = PathTracer.Parameters.x;
    uint randomState =
        pixelIndex * 747796405u +
        sampleIndex * 2891336453u +
        0xA511E9B3u;

    // Every accumulated frame gets a different sub-pixel sample.
    vec2 pixelJitter = vec2(
        RandomFloat(randomState),
        RandomFloat(randomState)) - vec2(0.5);

    vec3 origin = Camera.Position.xyz;
    vec3 direction = GetCameraRayDirection(
        vec2(pixel) + pixelJitter,
        vec2(size));

    vec3 radiance = vec3(0.0);
    vec3 throughput = vec3(1.0);

    uint maxBounces = max(PathTracer.Parameters.y, 1u);
    for (uint bounce = 0u; bounce < maxBounces; ++bounce)
    {
        Payload.Emission = vec3(0.0);
        Payload.Hit = 0u;

        traceRayEXT(
            TLAS,
            gl_RayFlagsOpaqueEXT,
            0xFF,
            0,
            0,
            0,
            origin,
            CERBERUS_RAY_T_MIN,
            direction,
            CERBERUS_RAY_T_MAX,
            0
        );

        radiance += throughput * max(Payload.Emission, vec3(0.0));

        // A miss has already returned the environment radiance through Emission.
        if (Payload.Hit == 0u)
            break;

        // Preserve the surface payload before tracing visibility rays. Shadow
        // traces intentionally reuse location 0 and would otherwise overwrite it.
        vec3 surfacePosition = Payload.WorldPosition;
        vec3 shadingNormal = normalize(Payload.ShadingNormal);
        vec3 geometricNormal = normalize(Payload.GeometricNormal);
        vec3 surfaceAlbedo = Payload.Albedo;
        float surfaceRoughness = Payload.Roughness;
        float surfaceMetalness = Payload.Metalness;
        vec3 viewDirection = normalize(-direction);

        // Next-event estimation for directional lights. A directional light is
        // a delta distribution, so it is evaluated explicitly and does not need
        // a light PDF or MIS weight. The shadow ray supplies visibility.
        uint directionalLightCount = min(
            DirectionalLights.Parameters.x,
            CERBERUS_MAX_DIRECTIONAL_LIGHTS);

        for (uint lightIndex = 0u; lightIndex < directionalLightCount; ++lightIndex)
        {
            DirectionalLightData light = DirectionalLights.Lights[lightIndex];
            vec3 lightDirection = normalize(light.DirectionAndIntensity.xyz);
            float lightIntensity = max(light.DirectionAndIntensity.w, 0.0);
            vec3 lightRadiance = max(light.Radiance.rgb, vec3(0.0)) * lightIntensity;

            float geometricNormalDotLight = dot(geometricNormal, lightDirection);
            float shadingNormalDotLight = dot(shadingNormal, lightDirection);
            if (geometricNormalDotLight <= 0.0 ||
                shadingNormalDotLight <= 0.0 ||
                lightIntensity <= 0.0)
            {
                continue;
            }

            // On an occlusion the closest-hit shader is skipped and Hit remains
            // one. On visibility the miss shader runs and changes Hit to zero.
            Payload.Hit = 1u;
            Payload.Emission = vec3(0.0);
            traceRayEXT(
                TLAS,
                gl_RayFlagsOpaqueEXT |
                    gl_RayFlagsTerminateOnFirstHitEXT |
                    gl_RayFlagsSkipClosestHitShaderEXT,
                0xFF,
                0,
                0,
                0,
                surfacePosition + geometricNormal * CERBERUS_RAY_T_MIN,
                CERBERUS_RAY_T_MIN,
                lightDirection,
                CERBERUS_RAY_T_MAX,
                0
            );

            if (Payload.Hit == 0u)
            {
                vec3 bsdf = EvaluatePBRBSDF(
                    viewDirection,
                    lightDirection,
                    shadingNormal,
                    surfaceAlbedo,
                    surfaceRoughness,
                    surfaceMetalness);
                radiance += throughput * bsdf * shadingNormalDotLight * lightRadiance;
            }
        }

        BSDFSample bsdfSample;
        if (!SamplePBRBSDF(
            viewDirection,
            shadingNormal,
            surfaceAlbedo,
            surfaceRoughness,
            surfaceMetalness,
            randomState,
            bsdfSample))
        {
            break;
        }

        if (dot(geometricNormal, bsdfSample.Direction) <= 0.0)
            break;

        throughput *= bsdfSample.Weight;

        // Russian roulette keeps long paths unbiased while limiting wasted work.
        if (bounce >= 2u)
        {
            float survivalProbability = clamp(
                max(throughput.r, max(throughput.g, throughput.b)),
                0.05,
                0.95);
            if (RandomFloat(randomState) > survivalProbability)
                break;
            throughput /= survivalProbability;
        }

        origin = surfacePosition + geometricNormal * CERBERUS_RAY_T_MIN;
        direction = bsdfSample.Direction;
    }

    // Online mean: previous + (new - previous) / sampleCount.
    // On a reset sampleIndex is zero, so stale image contents are intentionally
    // ignored and no explicit GPU clear is required.
    vec3 accumulatedRadiance = radiance;
    if (sampleIndex > 0u)
    {
        vec3 previousRadiance = imageLoad(RTAccumulation, pixel).rgb;
        float sampleCount = float(sampleIndex + 1u);
        accumulatedRadiance = previousRadiance +
            (radiance - previousRadiance) / sampleCount;
    }

    imageStore(RTAccumulation, pixel, vec4(accumulatedRadiance, 1.0));
    imageStore(RTOutput, pixel, vec4(LinearToDisplay(accumulatedRadiance), 1.0));
}
